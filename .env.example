# Copy this file to .env.local and fill in the values. Never commit .env.local.

# MongoDB Atlas connection string (Atlas → your cluster → Connect → Drivers).
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"

# Database name inside the cluster.
MONGODB_DB="paingains"

# Signs the login session cookie. 32+ random characters. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=""
